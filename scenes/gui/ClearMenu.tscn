[sub_resource type="GDScript" id="GDScript_ja72a"]
script/source = "extends Control

@export var scene: String = \"MainMenu\"
@onready var continue_button = $MarginContainer/VBoxContainer/VBoxContainer/Continue


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	self.hide()
	print(\"CM\" + scene)
	continue_button.scene_to_load = scene
"

[node name="ClearMenu" type="CenterContainer"]
anchors_preset = 15
